generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id        String    @id @default(cuid())
  courseId  String    @unique // URL ke liye
  name      String
  category  String
  level     String
  userId    String?
  createdAt DateTime  @default(now())
  
  chapters  Chapter[]
  quizzes   Question[] // 👈 Naya relation: Ek course ke bohot saare questions ho sakte hain
}

model Chapter {
  id        String   @id @default(cuid())
  name      String
  content   String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// 👇 Naya Model: Quiz Questions ke liye
model Question {
  id            String   @id @default(cuid())
  questionText  String
  options       String[] // Array of strings (e.g., ["A", "B", "C", "D"])
  correctAnswer String   // The exact string of the correct option
  explanation   String   // AI batayega ki yeh answer kyun sahi hai
  
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}