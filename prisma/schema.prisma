generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id          String    @id @default(uuid())
  courseId    String    @unique // A short URL-friendly ID
  name        String    // e.g., "Fullstack Next.js"
  category    String    // e.g., "Programming"
  level       String    // e.g., "Beginner"
  courseOutput Json     // We will store the AI-generated JSON outline here
  createdAt   DateTime  @default(now())
  
  // Relation: One Course has Many Chapters
  chapters    Chapter[]
}

model Chapter {
  id          String   @id @default(uuid())
  courseId    String
  name        String   // Chapter title, e.g., "Introduction to APIs"
  youtubeId   String?  // Later, we can fetch a relevant YouTube video
  content     String?  @db.Text // The AI-generated detailed text for the chapter
  
  // Foreign Key linking back to Course
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}